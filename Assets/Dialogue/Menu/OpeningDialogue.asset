  lines:
  - speakerName: 
    text: Beyond These Accursed Castle Walls, There Awaits a Princess
    portrait: {fileID: 0}
    soundEffect: {fileID: 0}
  - speakerName: 
    text: Two Fighters, Head and Heel, Appear Across From Each Other Once Again
    portrait: {fileID: 0}
    soundEffect: {fileID: 0}
  - speakerName: Head
    text: '"Out of my way Heel, I am getting over you!"'
    portrait: {fileID: 21300000, guid: 6ec27bd7f69586846a1a8348ea74d6bc, type: 3}
    soundEffect: {fileID: 0}
  - speakerName: Heel
    text: '"You''ll have to get through me first, Head!"'
    portrait: {fileID: 21300000, guid: 499ed54a70d969549a99826074fcd08c, type: 3}
    soundEffect: {fileID: 0}
  - speakerName: 
    text: Fighters! Begin!
